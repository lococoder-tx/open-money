# Get these from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox

# Required for OAuth institutions (Fidelity, Chase, most large banks).
# Register this exact URI in the Plaid dashboard under "Allowed redirect URIs".
# Production requires https.
PLAID_REDIRECT_URI=http://localhost:5173/oauth

# 32 random bytes, hex. Generate with: openssl rand -hex 32
# Plaid access tokens are encrypted at rest with this key.
ENCRYPTION_KEY=

PORT=3001
DATABASE_PATH=./rocket.db
